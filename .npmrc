# Fait échouer clairement npm install si la version de Node ne correspond
# pas à ce qu'exigent react-native 0.86 / prisma 7 (cf. package.json
# "engines"), plutôt que de laisser passer un simple warning et provoquer
# des bugs difficiles à diagnostiquer plus tard.
engine-strict=true

# Les paquets React Native / Expo / Prisma sont volumineux : ces réglages
# réduisent le risque d'ECONNRESET sur une connexion instable, un
# proxy d'entreprise ou un VPN.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000

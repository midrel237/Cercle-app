{
  "expo": {
    "name": "Cercle",
    "slug": "cercle-tontine",
    "scheme": "cercle",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#3A4372"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cercle.tontine"
    },
    "android": {
      "package": "com.cercle.tontine"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}

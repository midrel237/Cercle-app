# ============================================================
# Cercle backend — variables d'environnement (copier en .env)
# Ne JAMAIS committer le .env réel (déjà dans .gitignore).
# ============================================================

# --- Base de données (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/cercle?schema=public"

# --- JWT ---
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# --- SMS OTP (Africa's Talking) ---
SMS_PROVIDER=console            # console (dev) | africastalking (prod)
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""

# --- eKYC Didit ---
DIDIT_API_KEY=""
DIDIT_CLIENT_ID=""
DIDIT_CLIENT_SECRET=""
DIDIT_WEBHOOK_SECRET=""
DIDIT_BASE_URL="https://id.didit.com"

# --- CinetPay (agrégateur Mobile Money) ---
CINETPAY_API_KEY=""
CINETPAY_SECRET_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_BASE_URL="https://api-checkout.cinetpay.com"
# URL publique du webhook (doit être joignable depuis Internet)
CINETPAY_NOTIFY_URL="https://votre-domaine/api/v1/payments/webhook"

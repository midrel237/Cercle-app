# ------- Backend -------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cercle:cercle@localhost:5432/cercle_db?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Agregateur Mobile Money (CinetPay / Maviance...) - Option A : facilitateur technique
MOMO_AGGREGATOR_BASE_URL=
MOMO_AGGREGATOR_API_KEY=
MOMO_AGGREGATOR_API_SECRET=
MOMO_WEBHOOK_SECRET=

# SMS (OTP & notifications) - SMS_PROVIDER=console | africas-talking
SMS_PROVIDER=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ------- Mobile (Expo) -------
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

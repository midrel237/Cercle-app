# ------- Backend -------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cercle:cercle@localhost:5432/cercle_db?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# eKYC Didit (developers.didit.com)
DIDIT_CLIENT_ID=
DIDIT_CLIENT_SECRET=
DIDIT_WEBHOOK_SECRET=
MOBILE_SCHEME=cercle

# Agrégateur Mobile Money — CinetPay (Option A : facilitateur technique)
# Utilisé par src/payments/cinetpay.aggregator.ts
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=
CINETPAY_SITE_ID=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com
# URL publique du webhook (doit être joignable depuis Internet)
CINETPAY_NOTIFY_URL=https://votre-domaine/api/v1/payments/webhook

# SMS (OTP & notifications) - SMS_PROVIDER=console | africastalking
SMS_PROVIDER=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ------- Mobile (Expo) -------
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

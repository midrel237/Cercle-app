# ------- Backend -------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cercle:cercle@localhost:5432/cercle_db?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# eKYC Didit v3 (docs.didit.me — verification.didit.me)
# API key d'application (header x-api-key) : Console Didit > API keys
DIDIT_API_KEY=
# UUID du workflow KYC publié : Console Didit > Workflows (publier avant usage)
DIDIT_WORKFLOW_ID=
# Secret de signature de la destination webhook : Console Didit > Webhooks
DIDIT_WEBHOOK_SECRET=
MOBILE_SCHEME=cercle

# Agrégateur Mobile Money — CinetPay (Option A : facilitateur technique)
# Utilisé par src/payments/cinetpay.aggregator.ts
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=
CINETPAY_SITE_ID=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com
# URL publique du webhook (doit être joignable depuis Internet)
CINETPAY_NOTIFY_URL=https://votre-domaine/api/v1/payments/webhook

# SMS_PROVIDER=console | termii
# console : affiche le code dans les logs backend et le renvoie dans devCode (dev/test)
# termii  : envoi un vrai SMS (nécessite une clé API Termii et un Sender ID approuvé)
SMS_PROVIDER=console
# ⚠️ Ne JAMAIS mettre de vraie clé API dans un fichier versionné.
# Copiez ce fichier vers apps/backend/.env (non versionné) et renseignez-y votre clé.
TERMII_API_KEY=
TERMII_SENDER_ID=Cercle

# ------- Mobile (Expo) -------
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
